{
  "name": "carbonsynq-scale-api",
  "version": "2.4.1-local-postgres-demo",
  "private": true,
  "type": "module",
  "description": "University sustainability with governed intake, evidence sharing, staff recovery, task transfer, notifications, local OCR and asynchronous inventory export; infrastructure acceptance required.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.mjs",
    "worker": "node --env-file-if-exists=.env src/worker-main.mjs",
    "setup": "node scripts/setup-env.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "tenant:create": "node --env-file-if-exists=.env scripts/provision.mjs",
    "test": "node --test tests/unit.test.mjs tests/http.test.mjs tests/adapters.test.mjs tests/university/core.test.mjs tests/university/domain.test.mjs tests/university/http.test.mjs tests/university/store.test.mjs tests/carbon/core.test.mjs tests/carbon/domain.test.mjs tests/carbon/contract.test.mjs tests/ingestion/normalize.test.mjs tests/ingestion/domain.test.mjs tests/ingestion/parser.test.mjs tests/ingestion/http.test.mjs tests/operations/*.test.mjs",
    "test:integration": "node --env-file-if-exists=.env tests/postgres.integration.mjs",
    "check": "node scripts/check.mjs",
    "storage:check": "node --env-file-if-exists=.env scripts/storage-check.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "load:smoke": "node --env-file-if-exists=.env scripts/load-smoke.mjs",
    "test:university": "node --test tests/university/core.test.mjs tests/university/domain.test.mjs tests/university/http.test.mjs tests/university/store.test.mjs",
    "test:university:postgres": "node --env-file-if-exists=.env tests/university/postgres.integration.mjs",
    "university:smoke": "node --env-file-if-exists=.env examples/university/smoke.mjs",
    "university:seed-demo": "node --env-file-if-exists=.env scripts/seed-university-demo.mjs",
    "university:verify-demo": "node --env-file-if-exists=.env scripts/verify-university-demo.mjs",
    "check:university": "node scripts/check-university.mjs",
    "test:carbon": "node --test tests/carbon/core.test.mjs tests/carbon/domain.test.mjs tests/carbon/contract.test.mjs",
    "test:carbon:postgres": "node --env-file-if-exists=.env tests/carbon/postgres.integration.mjs",
    "carbon:demo": "node examples/carbon/synthetic-workflow.mjs",
    "docs:carbon": "node scripts/build-ingestion-docs.mjs && node scripts/build-university-docs.mjs && node scripts/build-carbon-codebook.mjs",
    "test:ingestion": "node --test tests/ingestion/*.test.mjs",
    "ingestion:example": "node examples/ingestion/normalize-local.mjs",
    "test:ingestion:postgres": "node --env-file-if-exists=.env tests/ingestion/postgres.integration.mjs",
    "docs:ingestion": "node scripts/build-ingestion-docs.mjs && node scripts/build-university-docs.mjs",
    "test:operations": "node --test tests/operations/*.test.mjs",
    "docs:operations": "node scripts/build-operations-docs.mjs && node scripts/build-operations-codebook.mjs",
    "operations:mail": "node scripts/read-local-mail.mjs",
    "operations:preflight": "node --env-file-if-exists=.env scripts/operations-preflight.mjs",
    "backup:bundle": "node --env-file-if-exists=.env scripts/backup-bundle.mjs",
    "backup:verify": "node scripts/verify-backup-bundle.mjs",
    "test:operations:ocr": "node examples/operations/ocr-smoke.mjs",
    "test:operations:postgres": "node --env-file-if-exists=.env tests/operations/postgres.integration.mjs",
    "env:prepare": "npm run setup",
    "env:check": "node scripts/check-local-env.mjs",
    "test:env": "node scripts/check-local-env.mjs",
    "local:up": "npm run env:check && docker compose --env-file .env up --build -d",
    "local:status": "docker compose --env-file .env ps",
    "local:logs": "docker compose --env-file .env logs --tail 100 api worker migrate database scanner object-store",
    "local:provision": "npm run env:check && docker compose --env-file .env run --rm migrate node scripts/provision.mjs",
    "local:down": "docker compose --env-file .env down"
  },
  "dependencies": {
    "pg": "8.23.0",
    "@aws-sdk/client-s3": "3.1143.0"
  }
}
